# ---- server ----
PORT=4000
NODE_ENV=development
CORS_ORIGIN=http://localhost:5173

# ---- database ----
# Leave MONGO_URI empty to run on the built-in JSON file store (handy for a
# quick demo or CI). Set it to use MongoDB, which is what the MERN stack uses.
# MONGO_URI=mongodb://127.0.0.1:27017/voltwise
MONGO_URI=
DATA_DIR=./.data
